# ─── DNA CRM v1.0 — Variáveis de Ambiente ─────────────────────────────────
# Copie este arquivo para .env.local e preencha com seus valores.

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# PostgreSQL direto (scripts operacionais: smoke, backup, matriz de sync)
DATABASE_URL=postgres://postgres:sua-senha@db.seu-projeto.supabase.co:5432/postgres
# ou, alternativamente, apenas a senha:
# POSTGRES_PASSWORD=sua-senha-aqui

# Testes e2e (Playwright) — usuário admin de teste
# TEST_E2E_PASSWORD=

# Opcionais — Providers IA (FASE 2)
# OPENAI_API_KEY=
# CLAUDE_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_URL=http://localhost:11434